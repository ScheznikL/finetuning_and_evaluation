# Copy to paths.env, edit, then `source training/paths.env` before running any script in
# training/, preprocessing/ or generation/. The names match the substitutions made by sync_from_fork.sh.
# Values in comments are the original cluster paths.

export HUNYUAN_DIR=/path/to/build              # tree created by setup_tree.sh    (/dcs/pg24/u5745134/Desktop/dev/Hunyuan3D-2.1)
export DEV_DIR=$(dirname "$HUNYUAN_DIR")       #                                 (/dcs/pg24/u5745134/Desktop/dev)
export DATA_ROOT=/path/to/dataset              # raw/, preprocessed/, temp_prompts_staging/ (/dcs/large/u5745134/dataset)
export MODELS_DIR=/path/to/hy3dgen_models      # HY3DGEN_MODELS                  (/dcs/large/u5745134/hy3dgen_models)
export HF_CACHE_DIR=$HOME/.cache/huggingface   # HF_HOME                         (/dcs/large/u5745134/cache/huggingface)
export TRAIN_RESULTS_DIR=/path/to/train_results  # checkpoints                   (/dcs/large/u5745134/train_results)
export EVAL_OUT_DIR=/path/to/evaluation_out    # generated batches               (/dcs/large/u5745134/evaluation_test/testing_Hunuyuan3d)
export WORK_DIR=/path/to/work                  # anything else on large storage  (/dcs/large/u5745134)
